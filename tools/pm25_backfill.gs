function backfillPcdPreview() { bfPcdRun_(false); }
function backfillPcd() { bfPcdRun_(true); }

function bfPcdRun_(write) {
  const ss = SpreadsheetApp.openById(BF_SPREADSHEET_ID);
  const sh = ss.getSheetByName(BF_SHEET);
  const { byDate, rowOf, colOf } = bfReadSheet_();
  const days = Object.keys(PCD_FILL).sort();
  const plan = [];   // {d, name, v}
  let same = 0, cmpN = 0, absSum = 0, biasSum = 0, bigDiff = 0;
  days.forEach(d => BF_STATIONS.forEach(st => {
    const v = PCD_FILL[d][st.name];
    if (typeof v !== 'number') return;
    const have = byDate[d] && typeof byDate[d][st.name] === 'number' && byDate[d][st.name] > 0;
    if (have) { const e = byDate[d][st.name]; cmpN++; absSum += Math.abs(e - v); biasSum += (e - v); if (Math.abs(e - v) > 10) bigDiff++; if (e === v) same++; return; }
    plan.push({ d: d, name: st.name, v: v });
  }));
  const newDays = {}; plan.forEach(p => { if (!rowOf[p.d]) newDays[p.d] = 1; });
  console.log((write ? '▶ เขียนจริง' : '🔍 ตัวอย่าง (ยังไม่เขียนอะไร)') + ' · ไฟล์มี ' + days.length + ' วัน (' + days[0] + ' – ' + days[days.length - 1] + ')');
  console.log('ช่องที่จะเติม ' + plan.length + ' ค่า (แถวใหม่ ' + Object.keys(newDays).length + ' วัน) · ช่องที่ชีตมีค่าอยู่แล้ว ' + cmpN + ' ค่า (ไม่แตะ)');
  if (cmpN) console.log('เทียบค่าเดิมในชีตกับไฟล์: ต่างเฉลี่ย ' + (absSum / cmpN).toFixed(1) + ' µg/m³ · ลำเอียง (ชีต − ไฟล์) ' + (biasSum / cmpN).toFixed(1) + ' · ต่างเกิน 10 อยู่ ' + bigDiff + ' ค่า · ตรงกันเป๊ะ ' + same + ' ค่า');
  const byMonth = {}; plan.forEach(p => { const m = p.d.slice(0, 7); byMonth[m] = (byMonth[m] || 0) + 1; });
  console.log('จำนวนที่จะเติมแยกเดือน: ' + Object.keys(byMonth).sort().map(m => m + '=' + byMonth[m]).join(' · '));
  if (!write) { console.log('ถ้าตัวเลขดูสมเหตุสมผล ให้เลือกฟังก์ชัน backfillPcd แล้วกด Run'); return; }
  if (!plan.length) { console.log('ไม่มีช่องว่างให้เติม'); return; }

  const bk = BF_SHEET + '_backup_' + Utilities.formatDate(new Date(), 'GMT+7', 'yyyyMMdd_HHmm');
  sh.copyTo(ss).setName(bk);
  console.log('สำรองแท็บเดิมไว้ที่ ' + bk);
  const log = ss.getSheetByName('_backfill_log') || ss.insertSheet('_backfill_log');
  if (log.getLastRow() === 0) log.appendRow(['เวลาที่เติม', 'วันที่', 'จังหวัด', 'ค่า (µg/m³)', 'วิธี', 'จำนวนชั่วโมงที่มีค่า', 'แหล่ง']);
  const stamp = Utilities.formatDate(new Date(), 'GMT+7', 'yyyy-MM-dd HH:mm');
  const src = 'Air4Thai สถานี — ไฟล์ค่ารายวัน ปี 2568 (36dcc7e3-2025.xlsx) · 46T/113T/107T/114T';
  const logRows = [], newRows = {};
  plan.forEach(p => {
    logRows.push([stamp, p.d, p.name, p.v, 'air4thai-pcd-file', '', src]);
    if (rowOf[p.d]) sh.getRange(rowOf[p.d], colOf[p.name]).setValue(p.v);
    else { if (!newRows[p.d]) { const r = new Array(sh.getLastColumn()).fill(''); r[0] = p.d; newRows[p.d] = r; } newRows[p.d][colOf[p.name] - 1] = p.v; }
  });
  const nr = Object.keys(newRows).sort().map(d => newRows[d]);
  if (nr.length) sh.getRange(sh.getLastRow() + 1, 1, nr.length, nr[0].length).setValues(nr);
  if (logRows.length) log.getRange(log.getLastRow() + 1, 1, logRows.length, logRows[0].length).setValues(logRows);
  console.log('✅ เติมค่า Air4Thai ปี 2568 ' + plan.length + ' ค่า (แถวใหม่ ' + nr.length + ' วัน) · บันทึกใน _backfill_log แล้ว');
}

/** อ่านแท็บ PM25_History → ค่ารายวัน, แถวของแต่ละวัน, คอลัมน์ของแต่ละจังหวัด */
function bfReadSheet_() {
  const sh = SpreadsheetApp.openById(BF_SPREADSHEET_ID).getSheetByName(BF_SHEET);
  const v = sh.getDataRange().getValues();
  const head = v[0].map(x => String(x).trim());
  const colOf = {};
  BF_STATIONS.forEach(st => {
    const c = head.indexOf(st.name);
    if (c < 0) throw new Error('ไม่พบคอลัมน์ ' + st.name + ' ในแท็บ ' + BF_SHEET);
    colOf[st.name] = c + 1;
  });
  const byDate = {}, rowOf = {};
  for (let i = 1; i < v.length; i++) {
    const d = bfNormDate_(v[i][0]);
    if (!d || byDate[d]) continue;   // เอาแถวแรกของแต่ละวัน (เหมือน server)
    rowOf[d] = i + 1;
    const row = {};
    BF_STATIONS.forEach(st => { const x = v[i][colOf[st.name] - 1]; if (x !== '' && !isNaN(+x)) row[st.name] = +x; });
    byDate[d] = row;
  }
  return { byDate, rowOf, colOf };
}

function bfNormDate_(x) {
  if (Object.prototype.toString.call(x) === '[object Date]' && !isNaN(x.getTime())) return Utilities.formatDate(x, 'GMT+7', 'yyyy-MM-dd');
  const s = String(x || '').trim();
  let m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s); if (m) return m[0];
  m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(s);
  if (m) { let y = +m[3]; if (y > 2400) y -= 543; return y + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[1]).slice(-2); }
  return '';
}
function bfAddDays_(iso, n) { return new Date(Date.parse(iso + 'T00:00:00Z') + n * 864e5).toISOString().slice(0, 10); }
function bfToday_() { return Utilities.formatDate(new Date(), 'GMT+7', 'yyyy-MM-dd'); }
