# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env อยู่ใน .gitignore จะไม่ถูก commit
# ค่าเหล่านี้จะ override ค่าใน config.json (ดู server.js บรรทัด ~95-105)
#
# บน Render ไม่ต้องมีไฟล์ .env — ตั้งค่าใน Dashboard → Environment แทน

GISTDA_KEY=your_gistda_api_key_here
SHEET_ID=your_google_sheet_id_here

# ADMIN_PASSWORD_HASH = bcrypt hash — ไม่ต้องกรอกเอง รัน `node tools/admin-password.js`
# แล้วสคริปต์จะเขียนลงไฟล์นี้ให้ (ครอบด้วย ' เพราะ hash มี $)
# hash อยู่ที่นี่ที่เดียว ไม่อยู่ใน config.json อีกแล้ว (config.json อยู่ใน repo สาธารณะ)
# (ห้ามใส่รหัสผ่านดิบ — server.js อ่านเฉพาะ hash)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

PORT=3000
